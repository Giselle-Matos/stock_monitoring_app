    "web": {
      "favicon": "./assets/bull_splash_screen.png"
    },
    "extra": {
      "eas": {
        "projectId": "dc696c6c-d824-4095-9c38-a714894b1177"
      }
    },
    "owner": "gisellematoss-team",
    "plugins": [
      "@react-native-google-signin/google-signin"
    ]
  }
}
